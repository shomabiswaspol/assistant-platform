# Copy to .env (chmod 600). Mounted read-only into the assistant-backend container.

# --- fazle-core read-only data bridge ---
# This reuses fazle-core's EXISTING read-only Postgres role (fazle_ai_reader),
# already scoped to ai_read_* views only (see /home/azim/core/modules/ai_readonly_tools/).
# Nothing in fazle-core was modified to support this — it's pure reuse.
#
# To fill this in: open /home/azim/core/.env, find the line starting
# FAZLE_AI_READER_DB_URL=, copy it here, and change the host from its
# internal docker IP (172.20.0.x) to `host.docker.internal` — ai-postgres
# already publishes 127.0.0.1:5432 to the host, and host.docker.internal
# reaches that from inside this app's containers (same pattern already used
# for Ollama in docker-compose.yml).
#
# Example shape (values differ): postgresql://fazle_ai_reader:PASSWORD@host.docker.internal:5432/postgres
FAZLE_AI_READER_DB_URL=

# Provider API keys (optional — OmniRoute also reads these; duplicated here
# only if the backend ever calls a provider directly instead of via OmniRoute)
GROQ_API_KEY=
GOOGLE_AI_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
