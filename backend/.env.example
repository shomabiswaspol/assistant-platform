# Copy to .env (chmod 600). Mounted read-only into the assistant-backend container.

# --- fazle-core read-only data bridge ---
# Reuses fazle-core's EXISTING read-only Postgres role (fazle_ai_reader),
# audited 2026-08-02: SELECT-only on exactly 10 ai_read_* views, no raw
# tables, no write grants (rolsuper=false, rolcreatedb=false). Nothing in
# fazle-core was modified to support this.
#
# Host/port/dbname below are already correct. NOTE: ai-postgres only
# publishes 127.0.0.1:5432 on the HOST's real loopback — a container-to-
# container connection via host.docker.internal silently times out (traffic
# arrives via the bridge gateway, not true loopback, so the loopback-only
# port publish never matches it). assistant-backend is instead attached
# directly to the pre-existing `db-network` docker network (declared
# `external: true` in docker-compose.yml — joined additively, ai-postgres
# and everything else on that network is untouched), and reaches ai-postgres
# by its container DNS name.
# Only FAZLE_DB_PASSWORD needs filling in — copy it from the
# FAZLE_AI_READER_DB_URL line in /home/azim/core/.env yourself; paste just
# the password here, not the full URL.
FAZLE_DB_ENABLED=false
FAZLE_DB_HOST=ai-postgres
FAZLE_DB_PORT=5432
FAZLE_DB_NAME=postgres
FAZLE_DB_USER=fazle_ai_reader
FAZLE_DB_PASSWORD=
FAZLE_DB_MAX_POOL=3
FAZLE_DB_STATEMENT_TIMEOUT=5000

# Provider API keys (optional — OmniRoute also reads these; duplicated here
# only if the backend ever calls a provider directly instead of via OmniRoute)
GROQ_API_KEY=
GOOGLE_AI_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
