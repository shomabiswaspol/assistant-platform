# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@iamazim.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Free-tier cloud providers (Priority 1 in OmniRoute routing) — optional, add what you have
GROQ_API_KEY=
GOOGLE_AI_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=

# Paid cloud providers (Priority 3 fallback) — optional
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# SMTP for password-reset emails — leave blank to disable email sending
# (backend will log the reset link instead of emailing it until this is filled in)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iamazim.com
